# Required in production. Sign in with username: 1day1life
APP_PASSWORD=
# Supabase Transaction Pooler URL (port 6543). Required on Vercel.
# Keep this server-side: never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Supabase Database Settings > SSL Configuration > Download certificate.
# Paste the complete PEM certificate; actual newlines or literal \n are supported.
DATABASE_CA_CERT=
# Local development only when DATABASE_URL is unset.
DATABASE_PATH=./data/1day1life.sqlite
